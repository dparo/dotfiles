# vi: ft=cfg

[global]
    enable_posix_regex = true

    font = "Sans Serif 10.5"

    icon_position = left

    ####
    #### ICON THEMING
    ####

    ##
    ## Legacy hardcoded icon paths
    ##
    # icon_path = "/usr/share/icons/Yaru/48/notifications:/usr/share/icons/Yaru/16/status:/usr/share/icons/Yaru/22/status:/usr/share/icons/Yaru/24/status:/usr/share/icons/Yaru/32/status:/usr/share/icons/Yaru/48/status:/usr/share/icons/Yaru/64/status:/usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/"
    # icon_path = /usr/share/icons/Adwaita/32x32/status/:/usr/share/icons/Adwaita/32x32/devices/:/usr/share/icons/Adwaita/32x32/emblems/:/usr/share/icons/Adwaita/32x32/actions/:/usr/share/icons/Adwaita/32x32/emotes/

    ##
    ## Icon themes with fallbacks
    ##
    icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita,breeze-dark,Numix,Yaru,Faenza,DMZ-White,Vanilla-DMZ

    min_icon_size = 32
    max_icon_size = 40
    icon_corner_radius = 8

    markup = full
    corner_radius = 12
    ellipsize = end

    ignore_newline = no

    stack_duplicates = true
    hide_duplicate_count = false

    show_indicators = yes

    # %a app name, %s summary, %b body
    format = "<span foreground='#7aa2f7'>%a</span>\n<b>%s</b>\n%b"

    sort = yes
    indicate_hidden = yes

    alignment = left
    vertical_alignment = center
    show_age_threshold = -1

    word_wrap = yes

    origin = bottom-right
    offset = 20x20

    ### Notification card geometry
    width = (320, 420)
    height = (0, 180)
    notification_limit = 4

    transparency = 0

    # Do not remove notifications while idle for this long.
    # Set to 0 to disable.
    idle_threshold = 120

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    progress_bar_min_width = 150
    progress_bar_max_width = 392
    highlight = "#7aa2f7"

    # Fallback monitor if follow is set to none.
    monitor = 0
    follow = keyboard

    sticky_history = yes

    # Extra spacing between text lines.
    line_height = 2

    # Separate notifications into individual cards.
    gap_size = 8
    separator_height = 0

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    frame_width = 1
    frame_color = "#414868"
    separator_color = frame

    # Context-menu launcher
    dmenu = /usr/bin/dmenu -p dunst:

    # Browser for URLs in the context menu
    browser = /usr/bin/firefox -new-tab

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1f2335"
    foreground = "#c0caf5"
    frame_color = "#9ece6a"
    highlight = "#9ece6a"
    timeout = 16

[urgency_normal]
    background = "#292e42"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    highlight = "#7aa2f7"
    timeout = 16

[urgency_critical]
    background = "#3b2335"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0

[appname=notify-osd]
    # Do not show app name for notify-osd notifications.
    format = "<b>%s</b>\n%b"

[teams_from_brave]
    appname = "Brave"
    desktop_entry = "brave-browser"
    body = "teams[.]cloud[.]microsoft"

    urgency = normal
    override_pause_level = 30
    timeout = 5s
    override_dbus_timeout = 5s
